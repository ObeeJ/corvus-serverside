# ──────────────────────────────────────────────────────────────
# Paystack Configuration
# ──────────────────────────────────────────────────────────────
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Public-facing URL for this deployment. All Paystack URLs derive from this.
# In production set to e.g. https://app.corvus.sh
PUBLIC_URL=http://localhost:3001

# ──────────────────────────────────────────────────────────────
# Paystack Dashboard Setup (one-time, after first deploy)
# ──────────────────────────────────────────────────────────────
# In the Paystack dashboard → Settings → Webhooks/API, configure:
#
#   Callback URL (Settings → API Keys & Webhooks → Callback URL):
#     ${PUBLIC_URL}/billing?success=true
#
#   Webhook URL (Settings → API Keys & Webhooks → Webhook URL):
#     ${PUBLIC_URL}/api/v1/billing/webhook
#
# Local dev: expose via ngrok/cloudflared and use the public URL.
#   Example:  ngrok http 3001  →  https://abc.ngrok.app/api/v1/billing/webhook
#
# Webhook events Corvus listens for: charge.success
# ──────────────────────────────────────────────────────────────

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/corvus?sslmode=disable

# JWT Secret for authentication
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# LLM Configuration (optional)
CORVUS_LLM_API_KEY=your_anthropic_or_openai_api_key_here

# NVD API Key (optional for CVE lookups)
NVD_API_KEY=your_nvd_api_key_here